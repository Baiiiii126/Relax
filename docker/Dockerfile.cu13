# syntax=docker/dockerfile:1.7
# Build a Muon runtime from an existing CUDA 13 training image.
# The pipeline supplies the parent by digest and publishes the train and relax stages.
ARG BASE_IMAGE=scratch
ARG TRAIN_IMAGE=train
FROM ${BASE_IMAGE} AS train
FROM ${TRAIN_IMAGE} AS relax

RUN set -eu; \
    py=/opt/sglang/bin/python3; \
    test -d /root/Megatron-LM/megatron; \
    "$py" -c 'from importlib.metadata import version; print("Base torch", version("torch"))'; \
    if ! "$py" -c 'from absl import logging'; then \
        "$py" -m pip install --no-cache-dir --only-binary=:all: --no-deps absl-py==2.3.1; \
    fi; \
    printf '%s\n' 'emerging-optimizers==0.3.0 --hash=sha256:e993682a8b93b6953b3056b0d4e2714e3a3182b0c85f456bcc78d76cd7b47429' | \
        "$py" -m pip install --no-cache-dir --only-binary=:all: --no-deps --require-hashes -r /dev/stdin; \
    "$py" -c 'from importlib.metadata import version; assert version("emerging-optimizers") == "0.3.0"; from absl import logging'
